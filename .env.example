# 复制成 .env 再填真实值：  cp .env.example .env
# .env 已被 .gitignore 挡住，不会提交；这个 .example 文件是提交的，别往里写真实密码。

# --- 数据库 ---
DB_NAME=changxi
DB_USER=yaojiw
DB_PASSWORD=换成一串长密码
DB_ROOT_PASSWORD=换成另一串长密码

# --- JWT 签名密钥 ---
# 换掉 appsettings.json 里那个开发默认值，至少 32 个随机字符。
# 生成一个：openssl rand -hex 32
JWT_SECRET=换成随机字符串

# --- 对外端口 ---
APP_PORT=8080

# --- AI 伴学（可选，不填就是空的）---
DIFY_API_KEY=
DIFY_API_BASE=
