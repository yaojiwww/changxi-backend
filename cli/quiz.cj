package changxi_backend

import std.collection.*

// =============================================================================
// 题库与考试（真实题库，来自 docs/知识点练习题(1).docx）
//
// 题库分四类：基础 / 初级 / 中级 / 高级
//   基础 —— 基础知识（相关法律法规）
//   初级 —— 生活管理：组织饮水
//   中级 —— 生活管理：组织进餐
//   高级 —— 生活管理：组织睡眠
// 考试分三种：初级保育员 / 中级保育员 / 高级保育员
// 规则：选哪一级，就考「基础题 + 该级别题」。
// =============================================================================

// 一道题
public class Question {
    public var text: String = ""       // 题干
    public var optionA: String = ""    // 选项 A
    public var optionB: String = ""    // 选项 B
    public var optionC: String = ""    // 选项 C
    public var optionD: String = ""    // 选项 D
    public var answer: String = ""     // 正确答案：A / B / C / D
    public var category: String = ""   // 所属分类：基础 / 初级 / 中级 / 高级
    public var explanation: String = "" // 解析

    public Question(text: String, a: String, b: String, c: String, d: String,
                    answer: String, category: String, explanation: String) {
        this.text = text
        this.optionA = a
        this.optionB = b
        this.optionC = c
        this.optionD = d
        this.answer = answer
        this.category = category
        this.explanation = explanation
    }
}

// 全部题目（真实题库）
public func allQuestions(): Array<Question> {
    return [
        // —— 基础：基础知识（相关法律法规）——
        Question(
            "根据《托儿所幼儿园卫生保健管理办法》，婴幼儿入园（所）时应当查验的健康证明文件是（ ）",
            "出生医学证明", "儿童入园（所）健康检查表", "预防接种完成证明原件", "体格发育评价报告",
            "B", "基础",
            "儿童入园前须经医疗卫生机构健康检查，查验的是「儿童入园（所）健康检查表」。"),
        Question(
            "依据《未成年人保护法》，未成年人是指未满（ ）周岁的公民。",
            "14", "16", "18", "20",
            "C", "基础",
            "《未成年人保护法》第二条：未成年人指未满十八周岁的公民。"),
        Question(
            "根据《食品安全法》，托幼机构食堂制作的食品应当（ ）",
            "每餐样品留存48小时以上，每样不少于125克", "每餐样品留存24小时以上，每样不少于100克",
            "每餐样品留存72小时以上，每样不少于150克", "无需留样，但需做好进货查验记录",
            "A", "基础",
            "每餐食品成品留样，每品种不少于125克、留存48小时以上并记录。"),
        Question(
            "依据《托育机构保育指导大纲（试行）》，托育机构保育工作应遵循的基本原则中，不包括以下哪项？（ ）",
            "尊重儿童", "安全健康", "积极回应", "提前教学",
            "D", "基础",
            "四项基本原则是尊重儿童、安全健康、积极回应、科学规范；「提前教学」违背婴幼儿成长规律。"),

        // —— 初级：生活管理（组织饮水）——
        Question(
            "组织幼儿饮水时，最适宜的饮用水是（ ）",
            "冰镇凉白开", "温开水", "碳酸饮料", "纯净水替代日常饮水",
            "B", "初级",
            "温开水最接近体温、对胃肠刺激最小。冰水刺激肠胃，饮料含糖高，纯净水不能长期替代白开水。"),
        Question(
            "幼儿每次饮水前，保育员应先组织幼儿（ ）",
            "排队取杯", "洗手", "漱口", "做安静游戏",
            "B", "初级",
            "饮水前先洗手，防止手上污染物沾到杯口；顺序是洗手→排队→取杯→饮水。"),
        Question(
            "保育员为幼儿准备饮用水、判断水温是否适宜的正确方法是（ ）",
            "用嘴直接抿一口试温", "将水滴在自己手腕内侧试温", "用手触摸杯壁外侧即可", "凭经验估计，无需试温",
            "B", "初级",
            "手腕内侧皮肤娇嫩敏感，是试温的标准部位；用嘴接触幼儿水杯不卫生。"),

        // —— 中级：生活管理（组织进餐）——
        Question(
            "幼儿进餐前，保育员对餐桌进行消毒的正确顺序是（ ）",
            "清水擦→消毒液擦→清水擦", "消毒液擦→清水擦→消毒液擦", "清水擦→消毒液擦，无需再清擦", "只需用清水擦一遍即可",
            "A", "中级",
            "标准桌面消毒流程是「清—消—清」：清水擦去浮尘→消毒液擦拭→清水擦去残留，顺序不能颠倒。"),
        Question(
            "幼儿进餐过程中，保育员的正确做法是（ ）",
            "对吃得慢的幼儿进行批评，督促其快点吃", "随时添加饭菜，要求幼儿必须吃完",
            "观察幼儿进食情况，鼓励细嚼慢咽，不催食不训斥", "利用进餐时间教育挑食的幼儿，当场点名批评",
            "C", "中级",
            "回应性照料：观察、鼓励、耐心，反对催食、强制、当众批评。"),
        Question(
            "组织进餐时培养幼儿独立性的做法是（ ）",
            "全部由保育员代劳，幼儿只管吃", "鼓励幼儿力所能及地自取餐具、参与分发餐具，饭后自己清理餐具",
            "让幼儿互相喂饭，锻炼合作能力", "由吃得快的幼儿帮助吃得慢的幼儿喂饭",
            "B", "中级",
            "进餐也是培养自理能力的机会：自取餐具、分发餐具、饭后收拾；互相喂饭有卫生隐患。"),

        // —— 高级：生活管理（组织睡眠）——
        Question(
            "组织幼儿睡眠前，保育员应首先安排幼儿（ ）",
            "脱衣上床", "排尿", "听故事", "做安静游戏",
            "B", "高级",
            "睡前先排尿，防止尿床和起夜干扰睡眠；听故事等是排尿后帮助入眠的手段。"),
        Question(
            "对幼儿睡眠姿势的指导，正确的是（ ）",
            "俯卧压着睡最安稳，不必干预", "仰卧或右侧卧位较好，发现蒙头睡要及时纠正",
            "左侧卧位最有利于消化", "睡姿由幼儿自由选择，蒙头睡也不用管",
            "B", "高级",
            "仰卧或右侧卧为宜（右侧卧利于胃排空）；蒙头睡会缺氧必须纠正，俯卧有捂闷风险。"),
        Question(
            "幼儿睡眠期间，保育员巡视观察的重点不包括（ ）",
            "睡眠姿势与盖被情况", "面色、呼吸是否正常", "是否有遗尿、身体不适等异常", "幼儿入睡的快慢排名并记录名次",
            "D", "高级",
            "巡视观察睡姿、盖被、面色、呼吸、有无遗尿/异常等；给入睡快慢排名无照护价值。"),
    ]
}

// 报考等级 -> 分类名：1 初级 / 2 中级 / 3 高级
public func levelCategory(level: Int64): String {
    if (level == 1) {
        return "初级"
    } else if (level == 2) {
        return "中级"
    } else {
        return "高级"
    }
}

// 报考等级 -> 显示名
public func levelName(level: Int64): String {
    return "${levelCategory(level)}保育员"
}

// 某等级要考的题：基础题 + 该级别题
public func questionsForLevel(level: Int64): Array<Question> {
    let target = levelCategory(level)
    let result = ArrayList<Question>()
    for (q in allQuestions()) {
        if (q.category == "基础" || q.category == target) {
            result.add(q)
        }
    }
    return result.toArray()
}
