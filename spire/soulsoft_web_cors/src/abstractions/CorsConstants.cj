package soulsoft_web_cors.abstractions

protected class CorsConstants {
    /**
     * @brief 表示允许任意请求源的通配符值。
     */
    public static let AnyOrigin = "*"
    /**
     * @brief 表示允许任意请求头的通配符值。
     */
    public static let AnyHeader = "*"
    /**
     * @brief 表示允许任意请求方法的通配符值。
     */
    public static let AnyMethod = "*"
}
