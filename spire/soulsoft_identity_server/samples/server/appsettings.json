{
    "logging": {
        "logLevel": {
            "default": "Info",
            "soulsoft.web.cors.*": "Warn"
        }
    },
    "identityserver": {
        "clients": [
            {
                "clientId": "interactive.public",
                "clientName": "交互式公开客户端",
                "description": "用于前端应用的交互式公开客户端",
                "clientUri": "http://127.0.0.1:3000",
                "protocolType": "oidc",
                "enabled": true,
                "requireSecret": false,
                "requireConsent": true,
                "allowOfflineAccess": true,
                "allowedScopes": ["profile", "openid", "api"],
                "allowedRedirectUris": ["http://127.0.0.1:3000/callback.html"],
                "postLogoutRedirectUris": ["http://127.0.0.1:3000/index.html"],
                "allowedGrantTypes": ["refresh_token", "authorization_code"],
                "identityTokenLifetime": 3600,
                "accessTokenLifetime": 3600,
                "authorizationCodeLifetime": 300,
                "absoluteRefreshTokenLifetime": 2592000,
                "slidingRefreshTokenLifetime": 1296000,
                "refreshTokenExpiration": "Absolute",
                "refreshTokenUsage": "ReUse",
                "requirePkce": true,
                "allowPlainTextPkce": true,
                "clientSecrets": []
            },
            {
                "clientId": "local",
                "clientName": "本地客户端",
                "description": "本地开发测试客户端",
                "clientUri": "http://localhost:5000",
                "protocolType": "oidc",
                "enabled": true,
                "requireSecret": false,
                "allowOfflineAccess": true,
                "allowedScopes": ["openid", "profile", "api"],
                "allowedRedirectUris": [],
                "postLogoutRedirectUris": [],
                "allowedGrantTypes": ["authorization_code", "password"],
                "identityTokenLifetime": 10,
                "accessTokenLifetime": 3600,
                "authorizationCodeLifetime": 300,
                "absoluteRefreshTokenLifetime": 2592000,
                "slidingRefreshTokenLifetime": 1296000,
                "refreshTokenExpiration": "Absolute",
                "refreshTokenUsage": "ReUse",
                "requirePkce": false,
                "allowPlainTextPkce": true,
                "clientSecrets": [
                    {
                        "value": "secret",
                        "type": "sha256"
                    }
                ]
            }
        ],
        "identityResources": [
            {
                "name": "openid",
                "enabled": true,
                "required": true,
                "displayName": "OpenID",
                "description": "OpenID Connect 标准的身份资源",
                "claimTypes": ["sub"],
                "discoveryDocument": true
            },
            {
                "name": "profile",
                "enabled": true,
                "displayName": "Profile",
                "description": "用户的基本信息，如姓名、电子邮件等",
                "claimTypes": ["name", "email", "picture"],
                "discoveryDocument": true
            }
        ],
        "apiScopes": [
            {
                "name": "api",
                "enabled": true,
                "displayName": "Create Order",
                "description": "允许创建订单的权限",
                "discoveryDocument": true
            },
            {
                "name": "offline_access",
                "enabled": true,
                "displayName": "Offline Access",
                "description": "Allow offline access via refresh token",
                "discoveryDocument": true
            }
        ],
        "apiResources": [
            {
                "name": "order",
                "enabled": true,
                "displayName": "Order API",
                "description": "Order management API",
                "allowedScopes": ["api"],
                "claimTypes": ["sub"],
                "discoveryDocument": true,
                "secrets": []
            }
        ]
    }
}