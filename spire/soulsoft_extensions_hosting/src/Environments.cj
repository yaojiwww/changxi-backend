package soulsoft_extensions_hosting

/**
 * @brief 提供常用主机环境名称常量。
 */
public class Environments {
    /**
     * @brief 表示预发布环境名称。
     */
    public static const Staging = "Staging"

    /**
     * @brief 表示生产环境名称。
     */
    public static const Production = "Production"

    /**
     * @brief 表示开发环境名称。
     */
    public static const Development = "Development"
}
