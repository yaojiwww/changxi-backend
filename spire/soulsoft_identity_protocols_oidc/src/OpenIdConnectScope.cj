package soulsoft_identity_protocols_oidc

/**
 * @brief 定义常用 OpenID Connect 作用域常量。
 */
public class OpenIdConnectScopes {
    /**
     * @brief 表示 `address` 作用域。
     */
    public static const Address = "address"
    /**
     * @brief 表示 `email` 作用域。
     */
    public static const Email = "email"
    /**
     * @brief 表示 `offline_access` 作用域。
     */
    public static const OfflineAccess = "offline_access"
    /**
     * @brief 表示 `openid` 作用域。
     */
    public static const OpenId = "openid"
    /**
     * @brief 表示 `phone` 作用域。
     */
    public static const Phone = "phone"
    /**
     * @brief 表示 `profile` 作用域。
     */
    public static const Profile = "profile"
    /**
     * @brief 表示 `user_impersonation` 作用域。
     */
    public static const UserImpersonation = "user_impersonation"
}
