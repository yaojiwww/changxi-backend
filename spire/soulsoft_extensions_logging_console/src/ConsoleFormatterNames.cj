package soulsoft_extensions_logging_console

/**
 * @brief 提供内置控制台格式化器名称。
 */
public abstract class ConsoleFormatterNames {
    /**
     * @brief simple 格式化器名称。
     */
    public static let Simple = "simple"
    /**
     * @brief json 格式化器名称。
     */
    public static let Json = "json"
    /**
     * @brief systemd 格式化器名称。
     */
    public static let Systemd = "systemd"
}
